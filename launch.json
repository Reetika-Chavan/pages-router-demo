{
  "$schema": "https://schemas.launch.contentstack.com/v1.0/launch.schema.json",
  "version": 1,
  "functions": {
    "api/**": {
      "include": true
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "methods": ["GET", "POST"]
    },
    {
      "src": "/posts-with-odr/(.*)",
      "dest": "/posts-with-odr/$1"
    }
  ],
  "headers": [
    {
      "source": "/posts-with-odr/:id",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=40, stale-while-revalidate"
        }
      ]
    }
  ],
  "redirects": [],
  "rewrites": []
}
